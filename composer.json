{
    "name": "vulqen/symfony-bundle",
    "description": "Instrumentacja Symfony dla Vulqen: żądania HTTP, wyjątki i zapytania DBAL.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/DeveloperLancer/vulqen-sdk-php.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/event-dispatcher": "^6.4 || ^7.4",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "vulqen/php-sdk": "^0.1"
    },
    "require-dev": {
        "doctrine/dbal": "^3.8 || ^4",
        "doctrine/doctrine-bundle": "^2.11",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.5.50 || ^12.5.33",
        "symfony/framework-bundle": "^6.4 || ^7.4",
        "symfony/yaml": "^6.4 || ^7.4"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Spany db.query z middleware DBAL"
    },
    "autoload": {
        "psr-4": {
            "Vulqen\\SymfonyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vulqen\\SymfonyBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "bundle": "Vulqen\\SymfonyBundle\\VulqenBundle"
        }
    },
    "scripts": {
        "guard-path": "php bin/guard-no-path-repo",
        "phpstan": "phpstan analyse --memory-limit=512M"
    }
}
